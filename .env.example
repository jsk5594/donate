# ─────────────────────────────────────────────────────────────
# 기부CCTV — AI API 설정
#  · 이 파일은 양식입니다(깃에 올라감). 실제 키는 .env.local 에 넣으세요(깃에 안 올라감).
#  · 키를 하나도 넣지 않으면 "데모 모드"로 동작합니다(화면에 '데모 모드' 표시).
#  · 키를 넣은 뒤에는 개발 서버를 다시 시작해야 반영됩니다.
#  · 쓰는 곳: 주관기관 AI 감사 / 기부 도우미 챗봇 / 결산 보고서 자동 생성
# ─────────────────────────────────────────────────────────────

# 사용할 제공자: openai | gemini | anthropic
# 비워 두면 키가 입력된 제공자를 openai → gemini → anthropic 순서로 자동 선택
AI_PROVIDER=

# ── OpenAI (GPT) ── https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 비우면 기본값 gpt-4.1-mini
OPENAI_MODEL=
# OpenAI 호환 서버(Ollama·vLLM 등)를 쓸 때만 입력. 예: http://localhost:11434/v1
OPENAI_BASE_URL=

# ── Google Gemini ── https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 비우면 기본값 gemini-2.5-flash
GEMINI_MODEL=

# ── Anthropic Claude ── https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 비우면 기본값 claude-sonnet-5-5
ANTHROPIC_MODEL=

# ── 메인 페이지 '최신 기부 뉴스' (네이버 뉴스 검색 API) ── https://developers.naver.com/apps
# 애플리케이션 등록 시 사용 API에서 '검색'을 선택. 비우면 카드에 가상 기사를 '가상 데이터'로 표시
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
